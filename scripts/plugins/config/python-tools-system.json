{
  "id": "python-tools-system",
  "version": "0.2.2",
  "name": "Python Tools (System Python)",
  "description": "Python sandbox worker (sidecar) using system Python only (no bundled runtime).",
  "mcp_protocol_version": "2025-06-18",
  "platforms": ["macos_universal", "macos_x86_64", "macos_aarch64"],
  "workers": [
    {
      "id": "python",
      "kind": "mcp_stdio",
      "auto_start": false,
      "tools_namespace": "plugin:python-tools-system",
      "entrypoints": {
        "macos_universal": "bin/macos/universal/rzn-python-worker",
        "macos_x86_64": "bin/macos/x86_64/rzn-python-worker",
        "macos_aarch64": "bin/macos/aarch64/rzn-python-worker"
      },
      "args": [],
      "env": {}
    }
  ],
  "payloads": [
    {
      "source": "${RZN_PYTHON_WORKER_BIN_MACOS}",
      "dest": "bin/macos/universal/rzn-python-worker",
      "platforms": ["macos_universal"],
      "mode": "755"
    },
    {
      "source": "${RZN_PYTHON_WORKER_BIN_MACOS_X86_64}",
      "dest": "bin/macos/x86_64/rzn-python-worker",
      "platforms": ["macos_x86_64"],
      "mode": "755"
    },
    {
      "source": "${RZN_PYTHON_WORKER_BIN_MACOS_AARCH64}",
      "dest": "bin/macos/aarch64/rzn-python-worker",
      "platforms": ["macos_aarch64"],
      "mode": "755"
    }
  ],
  "shared_payloads": [
    {
      "source": "resources/systems/python_sandbox/system.metadata.system.yaml",
      "dest": "resources/systems/python_sandbox/system.metadata.yaml"
    },
    {
      "source": "examples/python_sandbox",
      "dest": "examples/python_sandbox"
    }
  ],
  "resources": [
    {
      "path": "resources/systems/python_sandbox/system.metadata.yaml"
    }
  ]
}
